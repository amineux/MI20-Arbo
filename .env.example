# Copy to .env in apps/api or repo root (dotenv loads cwd).

AUTH_DISABLED=true
PORT=5080
HOST=0.0.0.0
DEMO_USER=demo.user

# --- Database ---
# Default local: SQLite file (created on first start).
# MI20_DB_PATH=./data/mi20.db
# MI20_STORAGE_ROOT=./storage
#
# Postgres (docker-compose default, or Neon/Supabase):
# DATABASE_URL=postgres://mi20:mi20@127.0.0.1:5432/mi20
#
# Extra synthetic documents on first empty seed (demo scale; not a production dump):
# MI20_SEED_DOCS=3000
# For Access-like volume locally: MI20_SEED_DOCS=30000 (indexes are in place; first seed is slower).

# Azure SQL later only if IT mandates — see docs/sql/azure.sql (not wired in the Node API).

# Production Entra ID (set AUTH_DISABLED=false)
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_API_AUDIENCE=api://<api-app-id>
# AZURE_AD_API_SCOPE=api://<api-app-id>/access_as_user
# AZURE_AD_REDIRECT_URI=https://your-spa.example
# PUBLIC_WEB_URL=https://your-spa.example

# Alstom site BT_BTPIIMaroc-GestionDoc — see docs/DEPLOY_SHAREPOINT.md
# SHAREPOINT_SITE_URL=https://alstomgroup.sharepoint.com/sites/BT_BTPIIMaroc-GestionDoc
# SHAREPOINT_DRIVE_PATH=/GestionDoc/MI20

# Graph file hooks (optional; local storage/ used if GRAPH_DRIVE_ID unset)
# GRAPH_SITE_ID=alstomgroup.sharepoint.com,/sites/BT_BTPIIMaroc-GestionDoc
# GRAPH_DRIVE_ID=
# GRAPH_LIBRARY_PATH=/GestionDoc/MI20
